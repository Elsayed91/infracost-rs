#!/bin/sh
# Pre-commit hook for infracost-rs
#   Setup:
#   - Hook lives in .githooks/pre-commit (tracked in repo)
#   - Git configured with git config core.hooksPath .githooks

#   What it checks:
#   1. cargo fmt --check - formatting
#   2. cargo clippy --all-features -- -D warnings - lints

#   For new clones, run once:
#   git config core.hooksPath .githooks
set -e

echo "Running cargo fmt..."
cargo fmt --check
if [ $? -ne 0 ]; then
    echo "❌ cargo fmt check failed. Run 'cargo fmt' to fix."
    exit 1
fi

echo "Running cargo clippy..."
cargo clippy --all-features -- -D warnings
if [ $? -ne 0 ]; then
    echo "❌ cargo clippy failed. Fix the warnings above."
    exit 1
fi

echo "✅ Pre-commit checks passed!"
